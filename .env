# Arquivo de Configuração (.env)

# --- Configurações Gerais ---
DELAY_SEGUNDOS=1
MODO_ENVIO=WAHA

# --- Configurações da Planilha ---
# Nomes EXATOS das colunas no seu arquivo Excel TRATADO
COLUNA_NOME=CLIENTE
COLUNA_TELEFONE=TELEFONE
COLUNA_VALOR=SALDO
COLUNA_VENCIMENTO=VENCTO.
COLUNA_LOTE=NUMERO
COLUNA_LOTEAMENTO=DUPLICATA

# --- Configuração da API WAHA ---
WAHA_API_KEY=coloque_sua_chave_secreta_aqui
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION_NAME=default