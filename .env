# Arquivo de Configuração (.env)

# --- Configurações Gerais ---
# Delay em segundos entre o processamento de cada linha da planilha
DELAY_SEGUNDOS=1

# --- Configurações da Planilha ---
# Nomes EXATOS das colunas no seu arquivo Excel TRATADO
COLUNA_NOME=CLIENTE
COLUNA_TELEFONE=TELEFONE
COLUNA_VALOR=SALDO
COLUNA_VENCIMENTO=VENCTO.
COLUNA_LOTE=NUMERO
COLUNA_LOTEAMENTO=DUPLICATA

# --- Configurações da API do WhatsApp Business (Cloud API) ---
# Necessário apenas se for implementar o envio via WhatsApp API
WHATSAPP_API_TOKEN=COLOQUE_SEU_TOKEN_DE_ACESSO_AQUI
WHATSAPP_PHONE_NUMBER_ID=COLOQUE_SEU_ID_NUMERO_TELEFONE_AQUI
WHATSAPP_API_VERSION=v19.0 # Verificar a versão mais recente suportada pela Meta
WHATSAPP_API_URL=https://graph.facebook.com/ # URL base da API Graph